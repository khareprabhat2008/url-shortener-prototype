# Example environment configuration
APP_NAME=url-shortener-prototype
APP_ENV=development
APP_DEBUG=true
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/urlshortener

# Redis
REDIS_URL=redis://redis:6379/0

# Security
ADMIN_TOKEN=dev-admin-token
